{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/London",
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "prHourlyLimit": 4,
  "rangeStrategy": "pin",
  "dependencyDashboard": true,
  "packageRules": [
    {
      "description": "Auto-merge patch + minor updates if CI is green.",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump pinned phpboyscout/cicd component versions in .gitlab-ci.yml.",
      "managerFilePatterns": [
        "/\\.gitlab-ci\\.yml$/"
      ],
      "matchStrings": [
        "component: gitlab\\.com/phpboyscout/cicd/[\\w-]+@(?<currentValue>v[\\d.]+)"
      ],
      "datasourceTemplate": "gitlab-tags",
      "depNameTemplate": "phpboyscout/cicd",
      "registryUrlTemplate": "https://gitlab.com",
      "extractVersionTemplate": "^(?<version>v[\\d.]+)$"
    }
  ]
}
